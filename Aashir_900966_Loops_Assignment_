      "Enter marks:  70\n",
      "Enter marks:  -1\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Valid Marks: [90, 85, 70]\n",
      "Average = 81.66666666666667\n"
     ]
    }
   ],
   "source": [
    "marks = []\n",
    "for i in range(5):\n",
    "  val = input(\"Enter marks: \")\n",
    "  if val == \"-1\":\n",
    "    break\n",
    "  m = int(val)\n",
    "  if m < 0 or m > 100:\n",
    "    print(\"Invalid marks\")\n",
    "    continue\n",
    "  marks.append(m)\n",
    "\n",
    "print(\"Valid Marks:\", marks)\n",
    "if len(marks) > 0:\n",
    "  avg = sum(marks) / len(marks)\n",
    "  print(\"Average =\", avg)\n",
    "else:\n",
    "  print(\"No valid marks entered.\")"
   ]
