    "### Example:\n",
    "\n",
    "    Is Ali present? yes  \n",
    "    Is Sara present? no  \n",
    "    Is Ahmed present? yes  \n",
    "    Is Ayesha present? yes  \n",
    "    Present Students: ['Ali', 'Ahmed', 'Ayesha']"
